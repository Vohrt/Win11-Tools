<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Win11EasyConfig.App.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:s="using:Win11EasyConfig.App.ViewModels.Settings"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>

        <!-- Toggle -->
        <DataTemplate x:Key="ToggleTemplate" x:DataType="s:ToggleSettingViewModel">
            <Border
                Margin="0,0,0,8"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind Title}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasDescription}"
                            Text="{x:Bind Description}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="6,1"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind ShowEffectBadge}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind EffectLabel}" />
                            </Border>
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasError, Mode=OneWay}"
                                Text="{x:Bind ErrorMessage, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="{x:Bind IsUnknown, Mode=OneWay}"
                                Text="无法读取当前状态" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ShowDisabledReason, Mode=OneWay}"
                                Text="{x:Bind DisabledReason, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <muxc:ProgressRing Width="18" Height="18" IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                        <ToggleSwitch
                            MinWidth="0"
                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                            IsOn="{x:Bind IsOn, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Choice -->
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="s:ChoiceSettingViewModel">
            <Border
                Margin="0,0,0,8"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind Title}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasDescription}"
                            Text="{x:Bind Description}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ShowDisabledReason, Mode=OneWay}"
                            Text="{x:Bind DisabledReason, Mode=OneWay}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                        ItemsSource="{x:Bind Options}"
                        SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Numeric -->
        <DataTemplate x:Key="NumericTemplate" x:DataType="s:NumericSettingViewModel">
            <Border
                Margin="0,0,0,8"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind Title}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasDescription}"
                            Text="{x:Bind Description}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ShowDisabledReason, Mode=OneWay}"
                            Text="{x:Bind DisabledReason, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <muxc:NumberBox
                            MinWidth="120"
                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                            Minimum="{x:Bind Minimum}"
                            Maximum="{x:Bind Maximum}"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Value, Mode=TwoWay}" />
                        <Button
                            Content="应用"
                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                            Command="{x:Bind ApplyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Action group -->
        <DataTemplate x:Key="ActionGroupTemplate" x:DataType="s:ActionGroupViewModel">
            <Border
                Margin="0,0,0,8"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind GroupName}" />
                    <muxc:ItemsRepeater ItemsSource="{x:Bind Commands}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:StackLayout Spacing="6" />
                        </muxc:ItemsRepeater.Layout>
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="s:ActionCommandViewModel">
                                <Grid ColumnDefinitions="200,*" ColumnSpacing="12">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="OnActionClick"
                                        Content="{x:Bind Title}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasStatus, Mode=OneWay}"
                                        Text="{x:Bind StatusMessage, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                    </muxc:ItemsRepeater>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="28,12,28,0" RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Header, Mode=OneWay}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.RefreshCommand}" Content="重新读取状态" />
        </Grid>

        <muxc:ProgressBar Grid.Row="1" Margin="0,8,0,8" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2" Padding="0,4,12,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.Toggles}"
                    ItemTemplate="{StaticResource ToggleTemplate}" />

                <TextBlock
                    Margin="2,8,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="选项设置"
                    Visibility="{x:Bind ViewModel.HasChoices, Mode=OneWay}" />
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.Choices}"
                    ItemTemplate="{StaticResource ChoiceTemplate}" />

                <TextBlock
                    Margin="2,8,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="数值设置"
                    Visibility="{x:Bind ViewModel.HasNumerics, Mode=OneWay}" />
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.Numerics}"
                    ItemTemplate="{StaticResource NumericTemplate}" />

                <TextBlock
                    Margin="2,8,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="操作"
                    Visibility="{x:Bind ViewModel.HasActionGroups, Mode=OneWay}" />
                <ItemsControl
                    ItemsSource="{x:Bind ViewModel.ActionGroups}"
                    ItemTemplate="{StaticResource ActionGroupTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
