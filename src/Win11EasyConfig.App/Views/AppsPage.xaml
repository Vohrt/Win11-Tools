<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Win11EasyConfig.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Win11EasyConfig.App.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Margin="28,12,28,0" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="应用商店" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="安装或卸载系统内置应用与媒体扩展。" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.RefreshCommand}" Content="刷新状态" />
        </Grid>

        <!-- Scope + options -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            Margin="0,0,0,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <muxc:RadioButtons
                    x:Name="ScopeSelector"
                    MaxColumns="2"
                    SelectedIndex="0"
                    SelectionChanged="OnScopeSelectionChanged">
                    <x:String>当前用户应用管理</x:String>
                    <x:String>系统预装应用卸载</x:String>
                </muxc:RadioButtons>

                <StackPanel Orientation="Horizontal" Spacing="20" Visibility="{x:Bind ViewModel.IsCurrentUserScope, Mode=OneWay}">
                    <CheckBox Content="使用 WinGet 安装" IsChecked="{x:Bind ViewModel.UseWinGet, Mode=TwoWay}" />
                    <CheckBox Content="卸载时同时移除预配置" IsChecked="{x:Bind ViewModel.AlsoRemoveProvisioned, Mode=TwoWay}" />
                    <CheckBox Content="卸载前询问" IsChecked="{x:Bind ViewModel.AskBeforeUninstall, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <muxc:InfoBar
            Grid.Row="2"
            Margin="0,0,0,8"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational"
            Message="{x:Bind ViewModel.ScopeDescription, Mode=OneWay}" />

        <muxc:ProgressBar Grid.Row="3" Margin="0,0,0,8" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!-- App grid: wide horizontal cards, wrapping into responsive columns -->
        <ScrollViewer Grid.Row="4" Padding="0,0,12,24" VerticalScrollBarVisibility="Auto">
            <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.Apps}">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemHeight="112"
                        MinItemWidth="348"
                        MinRowSpacing="12" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StoreAppItemViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10">

                                <!-- Round avatar with the app's first character -->
                                <Border
                                    Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    Background="{x:Bind AvatarBrush}"
                                    CornerRadius="23"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind AvatarText}"
                                        VerticalAlignment="Center" />
                                </Border>

                                <!-- Name + state pill, one-line description, actions -->
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind Name}">
                                        <TextBlock
                                            MaxLines="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Grid MinWidth="56" VerticalAlignment="Center">
                                            <Border Padding="8,2" CornerRadius="10" HorizontalAlignment="Center"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{x:Bind ShowGreen, Mode=OneWay}">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Border>
                                            <Border Padding="8,2" CornerRadius="10" HorizontalAlignment="Center"
                                                    Background="#F3EAFB"
                                                    Visibility="{x:Bind ShowPurple, Mode=OneWay}">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="#7A34C9" Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Border>
                                            <Border Padding="8,2" CornerRadius="10" HorizontalAlignment="Center"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind ShowNeutral, Mode=OneWay}">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock
                                        MaxLines="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Description}"
                                        Visibility="{x:Bind HasDescription}" />

                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            MinHeight="28"
                                            Padding="12,2"
                                            FontSize="12"
                                            Command="{x:Bind InstallCommand}"
                                            Content="安装"
                                            IsEnabled="{x:Bind InstallEnabled, Mode=OneWay}"
                                            Visibility="{x:Bind ShowInstall, Mode=OneWay}" />
                                        <Button
                                            MinHeight="28"
                                            Padding="12,2"
                                            FontSize="12"
                                            Click="OnUninstallClick"
                                            Content="{x:Bind UninstallLabel, Mode=OneWay}"
                                            IsEnabled="{x:Bind UninstallEnabled, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <muxc:ProgressRing
                                    Grid.Column="2"
                                    Width="18"
                                    Height="18"
                                    IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind IsBusy, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
