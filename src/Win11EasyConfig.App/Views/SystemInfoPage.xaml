<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Win11EasyConfig.App.Views.SystemInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="28,12,28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="系统信息" />

            <Border
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="180,*" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="操作系统" />
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="版本" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DisplayVersion, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内部版本号" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.BuildNumber, Mode=OneWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="版本标识" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.EditionId, Mode=OneWay}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="计算机名" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.MachineName, Mode=OneWay}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="处理器" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.ProcessorCount, Mode=OneWay}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="系统目录" />
                    <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.SystemDirectory, Mode=OneWay}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行权限" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.ElevationStatus, Mode=OneWay}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.LoadCommand}" Content="刷新" />
                <Button Command="{x:Bind ViewModel.OpenWindowsSettingsCommand}" Content="打开 Windows 系统信息" />
                <muxc:ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoadingHardware, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Margin="0,4,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="硬件信息" />

            <Border
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="180,*" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="处理器" />
                        <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.ProcessorName, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内存" />
                        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.MemorySummary, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="硬盘" />
                        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{x:Bind ViewModel.DiskSummary, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="内存条" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MemorySticks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Margin="0,1" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="显卡" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Margin="0,1" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="硬盘" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Margin="0,1" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Text="Windows11 轻松设置 — .NET 10 + WinUI 3 版本。所有设置均可逆，改动前请确认说明文字。" />
        </StackPanel>
    </ScrollViewer>
</Page>
