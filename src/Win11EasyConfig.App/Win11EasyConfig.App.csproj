<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Win11EasyConfig.App</RootNamespace>
    <AssemblyName>Win11EasyConfig</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: an MSIX-packaged app cannot request administrator rights, and this tool
         needs elevation for HKLM writes and service control. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Required so `dotnet publish` generates a valid resources.pri; without it the published app
         crashes at startup (0xC000027B) failing to load WinUI's XAML resources. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- We never use the Windows AI / Machine Learning APIs, so keep their auto-initializer out
         (otherwise it would try to load the onnxruntime/DirectML DLLs we strip below). -->
    <StripUnusedMLRuntime Condition="'$(StripUnusedMLRuntime)' == ''">true</StripUnusedMLRuntime>
    <DisableWindowsAppSDKMLAutoInitialize Condition="'$(StripUnusedMLRuntime)' == 'true'">true</DisableWindowsAppSDKMLAutoInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win11EasyConfig.Core\Win11EasyConfig.Core.csproj" />
  </ItemGroup>

  <!--
    The Windows App SDK metapackage drags in the Windows AI / Machine Learning runtime
    (onnxruntime.dll + DirectML.dll, ~38 MB) which this app never uses. Drop those files from the
    published output so both the folder and single-file publishes stay small. Matching by file name
    and NuGet package id keeps this working across SDK versions.
  -->
  <Target Name="RemoveUnusedWindowsMLRuntime" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(StripUnusedMLRuntime)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'
                   or '%(ResolvedFileToPublish.Filename)' == 'onnxruntime'
                   or '%(ResolvedFileToPublish.Filename)' == 'onnxruntime_providers_shared'
                   or '%(ResolvedFileToPublish.Filename)' == 'DirectML'
                   or '%(ResolvedFileToPublish.Filename)' == 'Microsoft.Windows.AI.MachineLearning'" />
    </ItemGroup>
  </Target>

</Project>
