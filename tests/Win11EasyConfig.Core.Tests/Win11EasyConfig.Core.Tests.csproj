<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same target as the Core library; the tests exercise registry/service logic with fakes. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- xunit v3 tests run as a console app via Microsoft.Testing.Platform (no VSTest testhost).
         The runner is selected in global.json ("test": { "runner": "Microsoft.Testing.Platform" }). -->
    <OutputType>Exe</OutputType>
    <!-- The repo is x64-only, so build the test binary as x64 as well. -->
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Win11EasyConfig.Core\Win11EasyConfig.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
