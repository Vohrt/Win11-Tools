<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <!-- Keep output paths identical whether building the solution (Platform=x64) or a single
         project, so the documented bin\<Config>\<TFM> path always holds. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <Product>Windows11 Easy Config</Product>
    <Company>Windows11 Easy Config</Company>
    <Copyright>Copyright 2026</Copyright>
    <Version>1.3.0</Version>
  </PropertyGroup>

</Project>
